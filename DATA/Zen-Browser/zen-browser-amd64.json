{
  "name": "zen-browser-amd64",
  "version": "https://raw.githubusercontent.com/LyndsCorp/Casata-Forge/refs/heads/main/external_files/zen-browser/VERSION",
  "apt": [],
  "pacman": [],
  "dnf": [],
  "pip": [],
  "casata": [],
  
  "external_metadata": true,
  "release": {
    "url": "https://github.com/zen-browser/desktop/releases/download/1.21.14b/zen.linux-x86_64.tar.xz"
  },
  "guide": [
    {
      "file": "AppRun.sh",
      "dest": "/usr/bin",
      "name": "zen",
      "executable": true
    },
    {
      "file": "zen.desktop",
      "dest": "/usr/share/applications",
      "name": "zen.desktop"
    },
    {
      "file": "browser/chrome/icons/default/default16.png",
      "dest": "/usr/share/icons/hicolor/16x16/apps",
      "name": "zen.png"
    },
    {
      "file": "browser/chrome/icons/default/default32.png",
      "dest": "/usr/share/icons/hicolor/32x32/apps",
      "name": "zen.png"
    },
    {
      "file": "browser/chrome/icons/default/default48.png",
      "dest": "/usr/share/icons/hicolor/48x48/apps",
      "name": "zen.png"
    },
    {
      "file": "browser/chrome/icons/default/default64.png",
      "dest": "/usr/share/icons/hicolor/64x64/apps",
      "name": "zen.png"
    },
    {
      "file": "browser/chrome/icons/default/default128.png",
      "dest": "/usr/share/icons/hicolor/128x128/apps",
      "name": "zen.png"
    }
  ],
  "external_files": [
    "https://github.com/LyndsCorp/Casata-Forge/main/external_files/zen-browser/latest/VERSION",
    "https://github.com/LyndsCorp/Casata-Forge/main/external_files/zen-browser/zen.desktop",
